<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\NetfxLibvirt.ProtocolGen\NetfxLibvirt.ProtocolGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real-file tests read these next to the test DLL, copied at build
         time rather than located by walking up from the output directory
         at runtime — see the same reasoning in NetfxLibvirt.Tests.csproj's
         Integration\docker copy. Link controls the destination path since
         the source lives outside this project's own directory.

         Fetched (reference/fetch-upstream-x.sh), not vendored — see
         reference/README.md for why — so these Include paths won't exist
         on a fresh clone until that script has run. Condition="Exists(...)"
         on each keeps that a silent no-op at build time instead of an
         MSBuild error; RealProtocolFileTests/RealModuleTests skip cleanly
         at test time if the copy never landed. -->
    <None Include="..\..\reference\upstream-x\virnetprotocol.x" Link="reference\upstream-x\virnetprotocol.x" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\reference\upstream-x\virnetprotocol.x')" />
    <None Include="..\..\reference\upstream-x\remote_protocol.x" Link="reference\upstream-x\remote_protocol.x" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\reference\upstream-x\remote_protocol.x')" />
  </ItemGroup>

</Project>
